---
import Layout from '../layouts/Layout.astro';

// ── EDIT ME ──────────────────────────────────────────────────────────────
// Your GitHub username (used for the contributions graph + profile link).
const githubUsername = 'Rachelailing';

// Add / edit your projects here. The first 3 show by default; the rest are
// revealed when the visitor clicks "Show more". Set `featured: true` on the
// ones you want highlighted at the top.
//   - tags:   small tech labels shown under the title
//   - link:   repo or live-demo URL (leave '' to hide the link)
//   - status: 'Ongoing' (amber), 'Completed'/'Shipped' (green),
//            'Paused'/'Planned'/'Archived' (grey). '' hides the badge;
//            any other word still shows, in the default pink.
const projects = [
  {
    title: 'Driver Drowsiness Detection',
    description:
      'Final year project detecting driver yawns from video. MediaPipe mouth landmarks give a per-frame aspect ratio, hysteresis thresholds segment that signal into discrete mouth-opening events, and six temporal features per event feed a Random Forest classifier. A real-time webcam mode reuses the offline feature code directly, so live inputs cannot drift from what the model was trained on.',
    tags: ['Python', 'MediaPipe', 'scikit-learn', 'Computer Vision'],
    link: 'https://github.com/rachelailing/fyp_drowsiness',
    status: 'Ongoing',
    featured: true,
  },
  {
    title: 'Project Two',
    description:
      'Short description of your project — what it does, the problem it solves, and what you learned building it.',
    tags: ['Unity', 'C#', 'Game Dev'],
    link: '',
    status: '',
    featured: true,
  },
  {
    title: 'Project Three',
    description:
      'Short description of your project — what it does, the problem it solves, and what you learned building it.',
    tags: ['Python', 'Machine Learning'],
    link: '',
    status: '',
    featured: true,
  },
  {
    title: 'Project Four',
    description: 'Another project — fill in the details when you are ready.',
    tags: ['JavaScript', 'Web'],
    link: '',
    status: '',
    featured: false,
  },
  {
    title: 'Project Five',
    description: 'Another project — fill in the details when you are ready.',
    tags: ['Research'],
    link: '',
    status: '',
    featured: false,
  },
];
// ─────────────────────────────────────────────────────────────────────────

const featured = projects.filter((p) => p.featured);
const others = projects.filter((p) => !p.featured);

// These cards are rendered remotely as images, so their text colour is baked
// into the URL and cannot inherit the page theme. One variant per theme gets
// rendered and CSS crossfades between them, same as the hero photo.
const statTheme = {
  dark: { title: 'd98d99', text: 'f4e8ea', icon: 'd98d99' },
  light: { title: 'b0818a', text: '4a2f38', icon: 'b0818a' },
};

const statsUrl = (t: { title: string; text: string; icon: string }) =>
  `https://github-readme-stats.vercel.app/api?username=${githubUsername}` +
  `&show_icons=true&hide_border=true&bg_color=00000000` +
  `&title_color=${t.title}&text_color=${t.text}&icon_color=${t.icon}`;

const langsUrl = (t: { title: string; text: string }) =>
  `https://github-readme-stats.vercel.app/api/top-langs/?username=${githubUsername}` +
  `&layout=compact&hide_border=true&bg_color=00000000` +
  `&title_color=${t.title}&text_color=${t.text}`;
---

<Layout title="Projects · Rachel">
  <main class="projects">
    <h1 class="page-title">Projects</h1>

    <!-- GitHub contributions -->
    <section class="github">
      <div class="section-head">
        <h2>GitHub Contributions</h2>
        <a
          class="profile-link"
          href={`https://github.com/${githubUsername}`}
          target="_blank"
          rel="noopener noreferrer">@{githubUsername}</a
        >
      </div>
      <div class="stats-row">
        <div class="stat-card">
          <img
            class="themed light"
            src={statsUrl(statTheme.light)}
            alt={`${githubUsername}'s GitHub stats`}
            loading="lazy"
          />
          <img class="themed dark" src={statsUrl(statTheme.dark)} alt="" aria-hidden="true" loading="lazy" />
        </div>
        <div class="stat-card">
          <img
            class="themed light"
            src={langsUrl(statTheme.light)}
            alt={`${githubUsername}'s most used languages`}
            loading="lazy"
          />
          <img class="themed dark" src={langsUrl(statTheme.dark)} alt="" aria-hidden="true" loading="lazy" />
        </div>
      </div>

      <div class="contrib-card">
        <img
          src={`https://ghchart.rshah.org/c96f7d/${githubUsername}`}
          alt={`${githubUsername}'s GitHub contribution graph`}
          loading="lazy"
        />
      </div>
    </section>

    <!-- Highlighted projects -->
    <section class="highlights">
      <h2>Highlights</h2>
      <div class="grid">
        {
          featured.map((p) => (
            <article class="card">
              <div class="card-head">
                <h3>{p.title}</h3>
                {p.status && (
                  <span class={`status status-${p.status.toLowerCase()}`}>{p.status}</span>
                )}
              </div>
              <p>{p.description}</p>
              <div class="tags">
                {p.tags.map((t) => (
                  <span class="tag">{t}</span>
                ))}
              </div>
              {p.link && (
                <a
                  class="card-link"
                  href={p.link}
                  target="_blank"
                  rel="noopener noreferrer">
                  View project →
                </a>
              )}
            </article>
          ))
        }
      </div>

      {
        others.length > 0 && (
          <>
            <div id="more" class="grid more-grid">
              {others.map((p) => (
                <article class="card">
                  <div class="card-head">
                    <h3>{p.title}</h3>
                    {p.status && (
                      <span class={`status status-${p.status.toLowerCase()}`}>{p.status}</span>
                    )}
                  </div>
                  <p>{p.description}</p>
                  <div class="tags">
                    {p.tags.map((t) => (
                      <span class="tag">{t}</span>
                    ))}
                  </div>
                  {p.link && (
                    <a
                      class="card-link"
                      href={p.link}
                      target="_blank"
                      rel="noopener noreferrer">
                      View project →
                    </a>
                  )}
                </article>
              ))}
            </div>

            <button id="toggle-more" class="show-more">
              Show more ({others.length})
            </button>
          </>
        )
      }
    </section>
  </main>
</Layout>

<style>
  .projects {
    max-width: 1100px;
    margin: 0 auto;
    padding: clamp(2.5rem, 5vw, 3.5rem) clamp(1.25rem, 5vw, 2.5rem) 5rem;
  }

  .page-title {
    font-size: clamp(2.4rem, 5vw, 3.5rem);
    font-weight: 300;
    margin-bottom: 2.5rem;
  }

  h2 {
    font-size: clamp(1.5rem, 2.2vw, 1.8rem);
    font-weight: 400;
    margin-bottom: 1rem;
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .profile-link {
    color: var(--text);
    text-decoration: none;
    opacity: 0.85;
    font-size: 1.1rem;
    border-bottom: 1px solid var(--surface-border);
    transition: opacity 0.2s;
  }

  .profile-link:hover {
    opacity: 1;
  }

  .github {
    margin-bottom: 3.5rem;
  }

  .stats-row {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .stat-card {
    position: relative;
    background: var(--surface);
    border: 1px solid var(--surface-border);
    border-radius: 12px;
    padding: 1rem 1.25rem;
  }

  .stat-card img {
    width: 100%;
    display: block;
  }

  /* The light variant holds the box; the dark one fades in on top. */
  .stat-card .dark {
    position: absolute;
    top: 1rem;
    left: 1.25rem;
    right: 1.25rem;
    bottom: 1rem;
    width: auto;
    opacity: 0;
    transition: opacity var(--theme-fade) var(--theme-ease);
  }

  :global(:root[data-theme='dark']) .stat-card .dark,
  :global(:root:not([data-theme])) .stat-card .dark {
    opacity: 1;
  }

  @media (max-width: 760px) {
    .stats-row {
      grid-template-columns: 1fr;
    }
  }

  .contrib-card {
    background: var(--surface);
    border: 1px solid var(--surface-border);
    border-radius: 12px;
    padding: 1.25rem 1.5rem;
    overflow-x: auto;
  }

  .contrib-card img {
    width: 100%;
    min-width: 600px;
    display: block;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-top: 1.25rem;
  }

  .more-grid {
    display: none;
    margin-top: 1.5rem;
  }

  .more-grid.open {
    display: grid;
  }

  .card {
    background: var(--surface);
    border: 1px solid var(--surface-border);
    border-radius: 12px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    transition: background-color var(--theme-fade) var(--theme-ease),
                border-color var(--theme-fade) var(--theme-ease),
                transform 200ms var(--theme-ease);
  }

  .card:hover {
    transform: translateY(-3px);
    background: var(--surface-hover);
  }

  .card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .card h3 {
    font-size: 1.4rem;
    font-weight: 500;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    flex-shrink: 0;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.22rem 0.6rem;
    border-radius: 999px;
    border: 1px solid var(--surface-border);
    color: var(--text-secondary);
    white-space: nowrap;
  }

  .status::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--toggle-bg);
  }

  /* One colour per status; anything unrecognised keeps the default dot. */
  .status-ongoing {
    color: var(--status-ongoing);
    border-color: color-mix(in srgb, var(--status-ongoing) 40%, transparent);
  }

  .status-ongoing::before {
    background: var(--status-ongoing);
    animation: status-pulse 2.4s ease-in-out infinite;
  }

  .status-completed,
  .status-shipped {
    color: var(--status-done);
    border-color: color-mix(in srgb, var(--status-done) 40%, transparent);
  }

  .status-completed::before,
  .status-shipped::before {
    background: var(--status-done);
  }

  .status-paused,
  .status-planned,
  .status-archived {
    color: var(--status-idle);
    border-color: color-mix(in srgb, var(--status-idle) 40%, transparent);
  }

  .status-paused::before,
  .status-planned::before,
  .status-archived::before {
    background: var(--status-idle);
  }

  @keyframes status-pulse {
    0%, 100% { opacity: 1; }
    50%      { opacity: 0.3; }
  }

  @media (prefers-reduced-motion: reduce) {
    .status-ongoing::before {
      animation: none;
    }
  }

  .card p {
    font-size: 1.02rem;
    line-height: 1.6;
    color: var(--text-secondary);
    flex-grow: 1;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    font-size: 0.8rem;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    background: var(--toggle-bg);
    color: var(--toggle-icon);
    letter-spacing: 0.02em;
  }

  .card-link {
    color: var(--text);
    text-decoration: none;
    font-style: italic;
    border-bottom: 1px solid var(--surface-border);
    align-self: flex-start;
    transition: opacity 0.2s;
  }

  .card-link:hover {
    opacity: 0.75;
  }

  .show-more {
    margin-top: 2rem;
    display: block;
    margin-inline: auto;
    background: var(--toggle-bg);
    color: var(--toggle-icon);
    border: none;
    border-radius: 999px;
    padding: 0.75rem 2rem;
    font-size: 1.05rem;
    font-family: inherit;
    cursor: pointer;
    transition: background-color var(--theme-fade) var(--theme-ease),
                color var(--theme-fade) var(--theme-ease),
                transform 200ms var(--theme-ease);
  }

  .show-more:hover {
    transform: translateY(-2px);
  }
</style>

<script>
  const btn = document.getElementById('toggle-more');
  const more = document.getElementById('more');

  btn?.addEventListener('click', () => {
    const open = more?.classList.toggle('open');
    if (more) {
      const count = more.children.length;
      btn.textContent = open ? 'Show less' : `Show more (${count})`;
    }
  });
</script>
