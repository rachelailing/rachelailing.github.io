---
import Layout from '../layouts/Layout.astro';

// ── EDIT ME ──────────────────────────────────────────────────────────────
// Your GitHub username (used for the contributions graph + profile link).
const githubUsername = 'Rachelailing';

// Add / edit your projects here. The first 3 show by default; the rest are
// revealed when the visitor clicks "Show more". Set `featured: true` on the
// ones you want highlighted at the top.
//   - tags:   small tech labels shown under the title
//   - link:   repo or live-demo URL (leave '' to hide the link)
//   - status: 'Ongoing'/'Early'/'WIP' (amber), 'Completed'/'Shipped'/'MVP'
//            (green),
//            'Paused'/'Planned'/'Archived' (grey). '' hides the badge;
//            any other word still shows, in the default pink.
//   - note:   one short line under the description saying where it stands or
//            what is planned next. '' hides it.
const projects = [
  {
    title: 'Driver Drowsiness Detection',
    description:
      'Final year project detecting driver yawns from video. MediaPipe mouth landmarks give a per-frame aspect ratio, hysteresis thresholds segment that signal into discrete mouth-opening events, and six temporal features per event feed a Random Forest classifier. A real-time webcam mode reuses the offline feature code directly, so live inputs cannot drift from what the model was trained on.',
    tags: ['Python', 'MediaPipe', 'scikit-learn', 'Computer Vision'],
    link: 'https://github.com/rachelailing/fyp_drowsiness',
    status: 'Ongoing',
    note: '',
    featured: true,
  },
  {
    title: 'Link Up',
    description:
      'A campus side-hustle platform connecting students who want short-term work with people on campus hiring for it. Its core idea is a refundable commitment fee: a student pays a small deposit to lock in a job, and it is returned alongside their pay once the work is approved, which cuts down on no-shows. Built on vanilla JS with Supabase for data and Stripe Checkout through serverless functions for payments.',
    tags: ['JavaScript', 'Supabase', 'Stripe', 'PostgreSQL'],
    link: 'https://github.com/rachelailing/link-up',
    status: 'MVP',
    note: 'Prototype complete — Phase 2, the student marketplace, is in planning.',
    featured: true,
  },
  {
    title: 'Trashie',
    description:
      'A hackathon concept for smarter waste handling: an AI chatbot that answers recycling questions, camera-based sorting to identify what an item is, and routing to the nearest bin using ultrasonic sensors to tell which bins are already full. Built in Flutter with Riverpod for state.',
    tags: ['Flutter', 'Dart', 'OpenAI API', 'Mobile'],
    link: 'https://github.com/rachelailing/make2',
    status: 'Paused',
    note: 'The interface and screen flow are built and the GPT chatbot is connected; camera detection and the sorting and routing logic are still ahead.',
    featured: true,
  },
  {
    title: 'Project Four',
    description: 'Another project — fill in the details when you are ready.',
    tags: ['JavaScript', 'Web'],
    link: '',
    status: '',
    note: '',
    featured: false,
  },
  {
    title: 'Project Five',
    description: 'Another project — fill in the details when you are ready.',
    tags: ['Research'],
    link: '',
    status: '',
    note: '',
    featured: false,
  },
];
// ─────────────────────────────────────────────────────────────────────────

const featured = projects.filter((p) => p.featured);
const others = projects.filter((p) => !p.featured);

// These cards are rendered remotely as images, so their text colour is baked
// into the URL and cannot inherit the page theme. One variant per theme gets
// rendered and CSS crossfades between them, same as the hero photo.
const statTheme = {
  dark: { title: 'd98d99', text: 'f4e8ea', icon: 'd98d99' },
  light: { title: 'b0818a', text: '4a2f38', icon: 'b0818a' },
};

const statsUrl = (t: { title: string; text: string; icon: string }) =>
  `https://github-readme-stats.vercel.app/api?username=${githubUsername}` +
  `&show_icons=true&hide_border=true&bg_color=00000000` +
  `&title_color=${t.title}&text_color=${t.text}&icon_color=${t.icon}`;

const langsUrl = (t: { title: string; text: string }) =>
  `https://github-readme-stats.vercel.app/api/top-langs/?username=${githubUsername}` +
  `&layout=compact&hide_border=true&bg_color=00000000` +
  `&title_color=${t.title}&text_color=${t.text}`;
---

<Layout title="Projects · Rachel">
  <main class="projects">
    <h1 class="page-title">Projects</h1>

    <!-- GitHub contributions -->
    <section class="github">
      <div class="section-head">
        <h2>GitHub Contributions</h2>
        <a
          class="profile-link"
          href={`https://github.com/${githubUsername}`}
          target="_blank"
          rel="noopener noreferrer">@{githubUsername}</a
        >
      </div>
      <div class="stats-row">
        <div class="stat-card">
          <img
            class="themed light"
            src={statsUrl(statTheme.light)}
            alt={`${githubUsername}'s GitHub stats`}
            loading="lazy"
          />
          <img class="themed dark" src={statsUrl(statTheme.dark)} alt="" aria-hidden="true" loading="lazy" />
        </div>
        <div class="stat-card">
          <img
            class="themed light"
            src={langsUrl(statTheme.light)}
            alt={`${githubUsername}'s most used languages`}
            loading="lazy"
          />
          <img class="themed dark" src={langsUrl(statTheme.dark)} alt="" aria-hidden="true" loading="lazy" />
        </div>
      </div>

      <div class="contrib-card">
        <img
          src={`https://ghchart.rshah.org/c96f7d/${githubUsername}`}
          alt={`${githubUsername}'s GitHub contribution graph`}
          loading="lazy"
        />
      </div>
    </section>

    <!-- Highlighted projects -->
    <section class="highlights">
      <h2>Highlights</h2>
      <div class="grid">
        {
          featured.map((p) => (
            <article class="card">
              <div class="card-head">
                <h3>{p.title}</h3>
                {p.status && (
                  <span class={`status status-${p.status.toLowerCase().replace(/\s+/g, '-')}`}>{p.status}</span>
                )}
              </div>
              <p>{p.description}</p>
              {p.note && <p class="note">{p.note}</p>}
              <div class="tags">
                {p.tags.map((t) => (
                  <span class="tag">{t}</span>
                ))}
              </div>
              {p.link && (
                <a
                  class="card-link"
                  href={p.link}
                  target="_blank"
                  rel="noopener noreferrer">
                  View project →
                </a>
              )}
            </article>
          ))
        }
      </div>

      {
        others.length > 0 && (
          <>
            <div id="more" class="grid more-grid">
              {others.map((p) => (
                <article class="card">
                  <div class="card-head">
                    <h3>{p.title}</h3>
                    {p.status && (
                      <span class={`status status-${p.status.toLowerCase().replace(/\s+/g, '-')}`}>{p.status}</span>
                    )}
                  </div>
                  <p>{p.description}</p>
                  {p.note && <p class="note">{p.note}</p>}
                  <div class="tags">
                    {p.tags.map((t) => (
                      <span class="tag">{t}</span>
                    ))}
                  </div>
                  {p.link && (
                    <a
                      class="card-link"
                      href={p.link}
                      target="_blank"
                      rel="noopener noreferrer">
                      View project →
                    </a>
                  )}
                </article>
              ))}
            </div>

            <button id="toggle-more" class="show-more">
              Show more ({others.length})
            </button>
          </>
        )
      }
    </section>
  </main>
</Layout>

<style>
  .projects {
    max-width: 1100px;
    margin: 0 auto;
    padding: clamp(2.5rem, 5vw, 3.5rem) clamp(1.25rem, 5vw, 2.5rem) 5rem;
  }

  .page-title {
    font-size: clamp(2.4rem, 5vw, 3.5rem);
    font-weight: 300;
    margin-bottom: 2.5rem;
  }

  h2 {
    font-size: clamp(1.5rem, 2.2vw, 1.8rem);
    font-weight: 400;
    margin-bottom: 1rem;
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .profile-link {
    color: var(--text);
    text-decoration: none;
    opacity: 0.85;
    font-size: 1.1rem;
    border-bottom: 1px solid var(--surface-border);
    transition: opacity 0.2s;
  }

  .profile-link:hover {
    opacity: 1;
  }

  .github {
    margin-bottom: 3.5rem;
  }

  .stats-row {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }

  /* Collapses to nothing if both remote stat cards fail to load. */
  .stats-row:empty {
    display: none;
    margin-bottom: 0;
  }

  .stats-row:has(.stat-card:only-child) {
    grid-template-columns: 1fr;
  }

  .stat-card {
    position: relative;
    background: var(--surface);
    border: 1px solid var(--surface-border);
    border-radius: 12px;
    padding: 1rem 1.25rem;
  }

  .stat-card img {
    width: 100%;
    display: block;
  }

  /* The light variant holds the box; the dark one fades in on top. */
  .stat-card .dark {
    position: absolute;
    top: 1rem;
    left: 1.25rem;
    right: 1.25rem;
    bottom: 1rem;
    width: auto;
    opacity: 0;
    transition: opacity var(--theme-fade) var(--theme-ease);
  }

  :global(:root[data-theme='dark']) .stat-card .dark,
  :global(:root:not([data-theme])) .stat-card .dark {
    opacity: 1;
  }

  @media (max-width: 760px) {
    .stats-row {
      grid-template-columns: 1fr;
    }
  }

  .contrib-card {
    background: var(--surface);
    border: 1px solid var(--surface-border);
    border-radius: 12px;
    padding: 1.25rem 1.5rem;
    overflow-x: auto;
  }

  .contrib-card img {
    width: 100%;
    min-width: 600px;
    display: block;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-top: 1.25rem;
  }

  .more-grid {
    display: none;
    margin-top: 1.5rem;
  }

  .more-grid.open {
    display: grid;
  }

  .card {
    background: var(--surface);
    border: 1px solid var(--surface-border);
    border-radius: 12px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    transition: background-color var(--theme-fade) var(--theme-ease),
                border-color var(--theme-fade) var(--theme-ease),
                transform 200ms var(--theme-ease);
  }

  .card:hover {
    transform: translateY(-3px);
    background: var(--surface-hover);
  }

  .card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .card h3 {
    font-size: 1.4rem;
    font-weight: 500;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    flex-shrink: 0;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.22rem 0.6rem;
    border-radius: 999px;
    border: 1px solid var(--surface-border);
    color: var(--text-secondary);
    white-space: nowrap;
  }

  .status::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--toggle-bg);
  }

  /* One colour per status; anything unrecognised keeps the default dot. */
  .status-ongoing,
  .status-early,
  .status-wip {
    color: var(--status-ongoing);
    border-color: color-mix(in srgb, var(--status-ongoing) 40%, transparent);
  }

  .status-ongoing::before,
  .status-early::before,
  .status-wip::before {
    background: var(--status-ongoing);
    animation: status-pulse 2.4s ease-in-out infinite;
  }

  .status-completed,
  .status-shipped,
  .status-mvp {
    color: var(--status-done);
    border-color: color-mix(in srgb, var(--status-done) 40%, transparent);
  }

  .status-completed::before,
  .status-shipped::before,
  .status-mvp::before {
    background: var(--status-done);
  }

  .status-paused,
  .status-planned,
  .status-archived {
    color: var(--status-idle);
    border-color: color-mix(in srgb, var(--status-idle) 40%, transparent);
  }

  .status-paused::before,
  .status-planned::before,
  .status-archived::before {
    background: var(--status-idle);
  }

  @keyframes status-pulse {
    0%, 100% { opacity: 1; }
    50%      { opacity: 0.3; }
  }

  @media (prefers-reduced-motion: reduce) {
    .status-ongoing::before {
      animation: none;
    }
  }

  .card > p {
    font-size: 1.02rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  /* Only the description absorbs slack, so cards in a row stay aligned. */
  .card > p:not(.note) {
    flex-grow: 1;
  }

  .note {
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--text-secondary);
    font-style: italic;
    padding-left: 0.75rem;
    border-left: 2px solid color-mix(in srgb, var(--toggle-bg) 55%, transparent);
    margin-top: -0.2rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    font-size: 0.8rem;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    background: var(--toggle-bg);
    color: var(--toggle-icon);
    letter-spacing: 0.02em;
  }

  .card-link {
    color: var(--text);
    text-decoration: none;
    font-style: italic;
    border-bottom: 1px solid var(--surface-border);
    align-self: flex-start;
    transition: opacity 0.2s;
  }

  .card-link:hover {
    opacity: 0.75;
  }

  .show-more {
    margin-top: 2rem;
    display: block;
    margin-inline: auto;
    background: var(--toggle-bg);
    color: var(--toggle-icon);
    border: none;
    border-radius: 999px;
    padding: 0.75rem 2rem;
    font-size: 1.05rem;
    font-family: inherit;
    cursor: pointer;
    transition: background-color var(--theme-fade) var(--theme-ease),
                color var(--theme-fade) var(--theme-ease),
                transform 200ms var(--theme-ease);
  }

  .show-more:hover {
    transform: translateY(-2px);
  }
</style>

<script>
  // github-readme-stats is a shared free service and is periodically paused or
  // rate limited. Drop the card rather than leaving a broken image on the page;
  // it comes back on its own once the service responds again.
  document.querySelectorAll<HTMLImageElement>('.stat-card img').forEach((img) => {
    const drop = () => img.closest('.stat-card')?.remove();
    img.addEventListener('error', drop);
    if (img.complete && img.naturalWidth === 0) drop();
  });

  const btn = document.getElementById('toggle-more');
  const more = document.getElementById('more');

  btn?.addEventListener('click', () => {
    const open = more?.classList.toggle('open');
    if (more) {
      const count = more.children.length;
      btn.textContent = open ? 'Show less' : `Show more (${count})`;
    }
  });
</script>
