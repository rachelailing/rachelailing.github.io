# Copy this file to `.env` and fill in the values from your Supabase project
# (Project Settings -> Data API for the URL, Project Settings -> API Keys for
# the key). Both are safe to expose in the browser -- the public/publishable
# key is constrained by the row-level security policies on the table.
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-publishable-key
